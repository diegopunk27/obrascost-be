PORT=4000

# Database (PostgreSQL + asyncpg)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=app_dev
# Set true only in local dev; use Alembic in production
SQLMODEL_SYNC=false

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=your_app_name
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO

# Tests: set TESTING=true to skip PostgreSQL engine startup (pytest)
TESTING=false
